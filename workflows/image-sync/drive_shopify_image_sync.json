      "parameters": {
        "jsCode": "const SHEETS = [\n'Animal','Bench','Planter','Fountain','Lamppost','Bathtub','Sink','Vanity', 'Fireplace','Table','Statue','MarbleSlab','2026Instock','DoorSurround', 'MarbleRangeHood','Moulding','StoneMosaicTile','MarbleMedallion', 'Wall-Coverings', 'Exterior-Wall-Decoration', 'Columns', 'Marble+ Basin', 'Marble+ ConsoleTable', 'Carving', 'WindowSurround', 'Wainscoting', 'BookMatchedSlabs', 'OutdoorCornice', 'Stairs', 'Balustrade'\n];\n// Clear any leftover data from a previous run\nconst sd = $getWorkflowStaticData('global');\nsd.allProducts = [];\nreturn SHEETS.map(s => ({ json: { sheet_name: s } }));"
