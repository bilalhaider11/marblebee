    {
      "id": "de657378-4ed6-4205-a0ff-013214e563f2",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4176,
        1680
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst sheets = ($('Get Sheet Ids').first().json.sheets || []).map(s => s.properties);\nconst sh = sheets.find(s => s.title === cfg.reviewTab);\nconst res = $input.first().json;\nif (!sh || res.error || !Array.isArray(res.values)) return [{ json: { ok: false, apply: false, problem: 'Review tab not found or not readable: ' + (sh ? JSON.stringify(res.error || res).slice(0, 200) : 'no tab named ' + cfg.reviewTab) } }];\nconst ans = String(cfg.answer || 'yes').toLowerCase() === 'no' ? 'no' : 'yes';\nconst keepF = String(cfg.keepFiles || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);\nconst only = String(cfg.tabs || '').split(',').map(x => x.trim()).filter(Boolean);\nconst norm = (x) => String(x ?? '').trim();\nconst vals = res.values;\nconst yes = [], keep = [];\nvals.forEach((r, i) => {\n  if (i === 0) return;\n  const tab = norm(r[0]).replace(/^.*?:\\s*/, '');\n  const f = norm(r[5]).toLowerCase();\n  if (f === ans && (!only.length || only.includes(tab)) && !keepF.includes(norm(r[1]).toLowerCase())) yes.push({ i, r });\n  else if (norm(r[0]) || norm(r[1])) keep.push({ row: i + 1, tab: norm(r[0]), drawing: norm(r[1]), answer: norm(r[5]), note: norm(r[6]) });\n});\nconst when = new Date().toISOString();\nconst width = 7;\nconst backup = [['removed_at'].concat((vals[0] || []).slice(0, width))].concat(yes.map(y => [when].concat(Array.from({ length: width }, (_, k) => norm(y.r[k])))));\n// delete from the bottom up so row numbers stay valid\nconst requests = yes.map(y => y.i).sort((a, b) => b - a).map(i => ({ deleteDimension: { range: { sheetId: sh.sheetId, dimension: 'ROWS', startIndex: i, endIndex: i + 1 } } }));\nconst dry = cfg.dryRun !== false;\nreturn [{ json: { ok: true, dryRun: dry, apply: !dry && yes.length > 0, yesRowsToRemove: yes.length, rowsThatStay: keep.length, stayByAnswer: keep.reduce((o, k) => { const a = k.answer.toLowerCase() || '(blank)'; o[a] = (o[a] || 0) + 1; return o; }, {}), staySample: keep.slice(0, 5), ...(dry ? {} : { backup, requests }) } }];"
      }
    },
