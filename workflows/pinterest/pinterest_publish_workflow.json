      "id": "27342ead-ea56-48cf-bdf2-828a907ddd9d",
      "name": "Normalize Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "position": [
        8080,
        3136
