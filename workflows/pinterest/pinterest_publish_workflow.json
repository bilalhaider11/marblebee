    {
      "parameters": {
        "jsCode": "const cfg = $('Set Config').first().json;\nconst pins1 = $('Get Pins').all().map(i => ({ ...i.json, _sourceTab: cfg.pinsTab }));\nconst pins2 = $('Get Pins 2').all().map(i => ({ ...i.json, _sourceTab: cfg.pinsTab2 }));\nconst pins = [...pins1, ...pins2];\nconst boards = $('Get Boards').all().map(i => i.json);\nfunction norm(s){ return (s==null?'':String(s)).replace(/[\\u2013-\\u2015]/g,'-').replace(/\\s+/g,' ').trim().toLowerCase(); }\nfunction bName(r){ return r['Board Name'] || r['Pinterest Board'] || r['Board'] || ''; }\nfunction bId(r){ return r['Board ID'] || r['Tailwind Board ID'] || ''; }\nfunction resolveBoardId(pin){\n  const direct = (pin['Board ID']==null?'':String(pin['Board ID'])).trim();\n  if (direct) return direct;\n  const name = norm(pin['Board']);\n  if (!name) return '';\n  let b = boards.find(r => norm(bName(r)) === name);\n  if (!b) b = boards.find(r => { const bn = norm(bName(r)); return bn && (bn.includes(name) || name.includes(bn)); });\n  return b ? String(bId(b)).trim() : '';\n}\nfunction toSendAt(v){\n  if (v==null || v==='') return '';\n  const s = String(v).trim();\n  const zone = 'America/Toronto'; // sheet stores naive local time -- anchor explicitly, don't rely on n8n's ambient default zone\n  let dt = DateTime.fromISO(s, { zone });\n  if(!dt.isValid) dt = DateTime.fromFormat(s,'yyyy-LL-dd HH:mm', { zone });\n  if(!dt.isValid) dt = DateTime.fromFormat(s,'yyyy-LL-dd H:mm', { zone });\n  if(!dt.isValid) dt = DateTime.fromFormat(s,'M/d/yyyy HH:mm:ss', { zone });\n  if(!dt.isValid) dt = DateTime.fromFormat(s,'M/d/yyyy H:mm:ss', { zone });\n  if(!dt.isValid) dt = DateTime.fromFormat(s,'M/d/yyyy H:mm', { zone });\n  if(!dt.isValid){ const d=new Date(s); if(!isNaN(d.getTime())) dt=DateTime.fromJSDate(d, { zone }); }\n  if(!dt || !dt.isValid) return '';\n  return dt.toUTC().toFormat(\"yyyy-LL-dd'T'HH:mm:ss'Z'\");\n}\nfunction bigImg(u){ u=String(u||''); if(/cdn\\.shopify\\.com/i.test(u)){ return u.split('?')[0] + '?width=1000'; } return u; }\nconst nowPlus15 = $now.plus({ minutes: 15 });\nconst out = [];\nfor (const pin of pins) {\n  if (norm(pin['Approval']) !== 'approved') continue;\n  const st = norm(pin['Status']);\n  if (st !== 'review' && st !== 'error') continue;\n\n  // Computed up front (before the cutoff branch) so a legacy row's explanatory\n  // note can mention its REAL underlying problems too (e.g. a missing board),\n  // not just its age -- fixing only the age wouldn't make it publishable anyway.\n  const boardId = resolveBoardId(pin);\n  const mediaUrl = bigImg(pin['Image 1 URL'] || '');\n  const rawSendAt = toSendAt(pin['Scheduled Date']);\n\n  if (cfg.newRowsOnlyAfter) {\n    // Existing backlog rows are left completely alone -- not retried, not\n    // rescheduled. Only rows created on/after this cutoff are eligible for\n    // actual processing. A missing/unparseable Created Time is treated as\n    // pre-cutoff (old), not as eligible.\n    const cutoff = DateTime.fromISO(cfg.newRowsOnlyAfter);\n    const created = DateTime.fromISO(String(pin['Created Time'] || ''));\n    if (!created.isValid || created < cutoff) {\n      // Silently skipping an overdue legacy row is confusing on the sheet --\n      // nothing changes, no error, no explanation. So if its own Scheduled\n      // Date has already passed, leave ONE explanatory note (never rewritten\n      // again once present, same dedupe principle as below) instead of\n      // leaving it looking untouched with no indication why.\n      const legacyOverdue = rawSendAt && DateTime.fromISO(rawSendAt) <= $now;\n      if (legacyOverdue) {\n        const otherIssues = [];\n        if (!mediaUrl) otherIssues.push('No image URL');\n        if (!boardId) otherIssues.push('Board not found: ' + (pin['Board'] || '(blank)'));\n        if (!rawSendAt) otherIssues.push('Invalid scheduled date');\n        const legacyNote = 'Not auto-processed: pre-existing row (created before ' + cfg.newRowsOnlyAfter + '). Scheduled time has passed -- update manually if you want this published.'\n          + (otherIssues.length ? ' Also: ' + otherIssues.join('; ') + '.' : '');\n        if (String(pin['Error'] || '') !== legacyNote) {\n          out.push({ json: {\n            row_number: pin['row_number'], sourceTab: pin._sourceTab, pinId: pin['Pin ID'],\n            ready: false, reason: legacyNote,\n            mediaUrl: '', title: '', description: '', url: '', boardId: '', altText: '', sendAt: ''\n          } });\n        }\n      }\n      continue;\n    }\n  }\n\n  let sendAt = rawSendAt;\n  let ready = true, reason = '';\n  if (!mediaUrl) { ready=false; reason='No image URL'; }\n  else if (!boardId) { ready=false; reason='Board not found: ' + (pin['Board']||'(blank)'); }\n  else if (!sendAt) { ready=false; reason='Invalid scheduled date'; }\n  else if (DateTime.fromISO(sendAt) <= nowPlus15) {\n    // Overdue -- give the human at least a full 24h approval window instead of\n    // rejecting it forever with no recovery path (business rule: 24h minimum).\n    sendAt = $now.plus({ hours: 24 }).toUTC().toFormat(\"yyyy-LL-dd'T'HH:mm:ss'Z'\");\n  }\n  if (!ready && reason === String(pin['Error'] || '')) {\n    // This exact failure is already recorded on the row -- nothing changed\n    // since last run (e.g. a permanently blank Board that only a human can\n    // fix), so don't burn a sheet write re-stating the same dead error every\n    // single day. Only a NEW or CHANGED reason gets written.\n    continue;\n  }\n  out.push({ json: {\n    row_number: pin['row_number'],\n    sourceTab: pin._sourceTab,\n    pinId: pin['Pin ID'], ready, reason,\n    mediaUrl,\n    title: String(pin['Pin Title']||'').slice(0,100),\n    description: String(pin['Pin Description']||'').slice(0,500),\n    url: pin['Blog Link'] || '',\n    boardId, altText: String(pin['Alt Text']||'').slice(0,500),\n    sendAt\n  } });\n}\n\n// Cap how many READY pins actually get published this run -- Create Pin does\n// real network calls to Metricool per pin, so a sudden backlog (e.g. right\n// after this fix ships) could otherwise blow past n8n's execution memory/time\n// limits or hammer Metricool with hundreds of requests in one run. Not-ready\n// items are cheap (no external call, just a status write) so they're never\n// capped. Deferred ready items are left untouched -- still Review/Error in\n// the sheet -- so the NEXT run picks them up, prioritizing the most overdue.\nconst maxPerRun = cfg.maxPublishPerRun || 50;\nconst notReady = out.filter(i => !i.json.ready);\nconst ready = out.filter(i => i.json.ready)\n  .sort((a, b) => (a.json.sendAt || '').localeCompare(b.json.sendAt || ''))\n  .slice(0, maxPerRun);\nreturn [...notReady, ...ready];\n"
      },
