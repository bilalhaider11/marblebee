      "parameters": {
        "jsCode": "// Emit one row per not-ready pin (runs once for all items).\nreturn $input.all().map(item => {\n  const p = item.json || {};\n  return {\n    json: {\n      'Row Number': p.row_number,\n      '_sourceTab': p.sourceTab,\n      'Pin ID': p.pinId,\n      'Status': 'Review',\n      'Metricool Post ID': '',\n      'Metricool Link': '',\n      'Error': p.reason || 'Not ready'\n    }\n  };\n});"
      },
