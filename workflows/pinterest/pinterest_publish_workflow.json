    {
      "parameters": {
        "jsCode": "// Each input item is one Metricool API response from \"Create Pin\",\n// in the same order as the pins that fed it. The pin metadata\n// (Pin ID, row_number, blog url) lives on \"IF Ready\", not on the\n// HTTP response, so pull it from there by index.\nconst responses = $input.all();\nconst pins = $('IF Ready').all();\nconst blogId = $('Set Config').first().json.blogId;\n\nreturn responses.map((item, index) => {\n  const response = item.json || {};\n  const pin = (pins[index] && pins[index].json) || {};\n  const post = response.data || {};\n  const ok = !!post.id;\n\n  return {\n    json: {\n      \"Row Number\": pin.row_number,\n      \"_sourceTab\": pin.sourceTab,\n      \"Pin ID\": pin.pinId,\n      \"Pin URL\": pin.url,\n      \"Status\": ok ? \"Scheduled\" : \"Error\",\n      \"Metricool Post ID\": post.id || \"\",\n      \"Metricool Link\": post.uuid ? ('https://app.metricool.com/planner/calendar?blogId=' + blogId + '&openWithPostUuid=' + post.uuid) : \"\",\n      \"Error\": ok ? \"\" : (response.message || response.error || \"Metricool API error\")\n    }\n  };\n});"
      },
