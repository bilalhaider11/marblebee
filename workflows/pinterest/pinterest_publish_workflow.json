    {
      "parameters": {
        "jsCode": "// One input item per ready pin, in the same order \"IF Ready\" emitted them\n// (Normalize Image doesn't filter or reorder). Combine the normalized image\n// URL with the rest of the pin's data from \"IF Ready\" by index, and convert\n// the UTC sendAt into the local time + timezone Metricool expects.\nconst pins = $('IF Ready').all();\nconst tz = 'America/Toronto';\n\nreturn $input.all().map((item, index) => {\n  const pin = (pins[index] && pins[index].json) || {};\n  const normalizedUrl = (item.json && item.json.data) || pin.mediaUrl;\n  const localDt = DateTime.fromISO(pin.sendAt, { zone: 'utc' }).setZone(tz).toFormat(\"yyyy-LL-dd'T'HH:mm:ss\");\n  return { json: {\n    text: pin.description,\n    publicationDate: { dateTime: localDt, timezone: tz },\n    providers: [{ network: 'pinterest' }],\n    media: [normalizedUrl],\n    mediaAltText: [pin.altText],\n    autoPublish: true,\n    draft: false,\n    pinterestData: {\n      boardId: pin.boardId,\n      pinTitle: pin.title,\n      pinLink: pin.url\n    }\n  } };\n});"
      },
