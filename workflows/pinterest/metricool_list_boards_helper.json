      "parameters": {
        "jsCode": "const resp = $json;\nconst boards = resp.data || resp || [];\nif (!Array.isArray(boards)) {\n  throw new Error('Unexpected boards response shape: ' + JSON.stringify(resp).slice(0, 500));\n}\nreturn boards.map(b => ({ json: {\n  'Pinterest Account': (b.owner && b.owner.username) || '',\n  'Board Name': b.name || '',\n  'Board ID': (b.id || '').toString()\n} }));\n"
