      "id": "8d991f2c-325f-411f-b1ba-4826f76d9669",
      "name": "Get Pins",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        10256,
        1168
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "rKfNzy77xzsMahH6",
          "name": "Template_control"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pins1 = $('Get Pins').all().map(i => ({ ...i.json, _sourceTab: $('Set Config').first().json.pinsTab }));\nconst pins2 = $('Get Pins 2').all().map(i => ({ ...i.json, _sourceTab: $('Set Config').first().json.pinsTab2 }));\nconst pins = [...pins1, ...pins2];\nfunction norm(s){ return (s==null?'':String(s)).trim().toLowerCase(); }\nconst out = [];\nfor (const p of pins) {\n  if (norm(p['Status']) !== 'scheduled') continue;\n  const postId = (p['Metricool Post ID']==null?'':String(p['Metricool Post ID'])).trim();\n  if (!postId) continue;\n  out.push({ json: { rowPinId: p['Pin ID'], postId, row_number: p['row_number'], sourceTab: p._sourceTab, retryCount: parseInt(p['Retry Count'], 10) || 0 } });\n}\nreturn out;\n"
      },
      "id": "dc113903-d1c3-45b4-ae64-a2aa754154c5",
      "name": "Select Scheduled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10640,
        1168
      ]
    },
    {
      "parameters": {
        "url": "=https://app.metricool.com/api/v2/scheduler/posts/{{ $json.postId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $('Set Config').first().json.userId }}"
            },
            {
              "name": "blogId",
              "value": "={{ $('Set Config').first().json.blogId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "9e044a14-a555-4db1-8e38-1718d5422f1d",
      "name": "Get Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        10864,
        1168
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "HyOn8LPYniNVacXo",
          "name": "Metricool API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst sel = $('Select Scheduled').all();\nconst cfg = $('Set Config').first().json;\nconst maxRetries = cfg.maxRetries || 3;\nconst retryHours = (cfg.retryHours || '9,10').split(',').map(h => parseInt(h.trim(), 10)).filter(h => !isNaN(h)).sort((a, b) => a - b);\n\nfunction nextRetrySlot() {\n  const zone = 'America/Toronto'; // retryHours (9,10) mean local business hours -- anchor explicitly, don't rely on n8n's ambient default zone\n  const nowPlus15 = $now.plus({ minutes: 15 });\n  const nowLocal = $now.setZone(zone);\n  for (const h of retryHours) {\n    const slot = nowLocal.set({ hour: h, minute: 0, second: 0, millisecond: 0 });\n    if (slot > nowPlus15) return slot;\n  }\n  // none of today's configured hours are far enough out -- use the earliest one tomorrow\n  return nowLocal.plus({ days: 1 }).set({ hour: retryHours[0], minute: 0, second: 0, millisecond: 0 });\n}\n\nfunction pickPost(r){ const o = Array.isArray(r)?(r[0]||{}):r; return (o && o.data) || o || {}; }\nfunction pickPinterestProvider(post){ const providers = post.providers || []; return providers.find(p => p.network === 'pinterest') || providers[0] || {}; }\nfunction pickHttpError(r){\n  // Get Post has onError: continueRegularOutput, so a failed lookup (e.g. a\n  // leftover pre-Metricool Tailwind post ID -- Metricool's API only accepts\n  // integer ids and 500s on those) comes through as { error: {...} } instead\n  // of throwing. Without this check those rows would silently look like\n  // \"still pending\" forever and retry-500 every single hourly run.\n  // Return a short, human-readable reason rather than the raw API error dump.\n  const o = Array.isArray(r) ? (r[0]||{}) : r;\n  if (o && o.error) return 'Could not verify this post on Metricool (invalid or pre-migration post ID)';\n  return null;\n}\nfunction pinnedTimeIso(post){\n  const pd = post.publicationDate;\n  if (!pd || !pd.dateTime) return '';\n  const dt = DateTime.fromISO(pd.dateTime, { zone: pd.timezone || 'utc' });\n  return dt.isValid ? dt.toUTC().toFormat(\"yyyy-LL-dd'T'HH:mm:ss'Z'\") : '';\n}\n\nconst out = [];\nfor (let i=0;i<responses.length;i++){\n  const raw = responses[i].json || {};\n  const httpError = pickHttpError(raw);\n  const post = httpError ? {} : pickPost(raw);\n  const provider = pickPinterestProvider(post);\n  const rowPinId = (sel[i] && sel[i].json.rowPinId) || '';\n  const rowNumber = (sel[i] && sel[i].json.row_number);\n  const sourceTab = (sel[i] && sel[i].json.sourceTab);\n  const retryCount = (sel[i] && sel[i].json.retryCount) || 0;\n  const postId = (sel[i] && sel[i].json.postId) || '';\n  if (!rowPinId) continue;\n  const status = httpError ? 'ERROR' : (provider.status || '').toString().toUpperCase();\n\n  if (status === 'PUBLISHED' && provider.publicUrl) {\n    out.push({ json: {\n      'row_number': rowNumber,\n      '_sourceTab': sourceTab,\n      'Pin ID': rowPinId,\n      'Status': 'Published',\n      'Pin URL': provider.publicUrl,\n      'Pinned Time': pinnedTimeIso(post),\n      'Error': '',\n      'Metricool Post ID': postId,\n      'Retry Count': retryCount,\n      'Scheduled Date': ''\n    } });\n  } else if (status === 'ERROR') {\n    const reason = httpError || String(provider.detailedStatus || 'Metricool reported this post as failed');\n    const newRetryCount = retryCount + 1;\n    if (newRetryCount <= maxRetries) {\n      // Auto-retry: hand it back to WF2 as a fresh Review row, with the stale\n      // Post ID cleared and a new near-future Scheduled Date (otherwise WF2 would\n      // immediately reject it again for having a past-due schedule instead of actually\n      // retrying it).\n      out.push({ json: {\n        'row_number': rowNumber,\n        '_sourceTab': sourceTab,\n        'Pin ID': rowPinId,\n        'Status': 'Review',\n        'Pin URL': '',\n        'Pinned Time': '',\n        'Metricool Post ID': '',\n        'Retry Count': newRetryCount,\n        'Scheduled Date': nextRetrySlot().toFormat('yyyy-LL-dd HH:mm'),\n        'Error': reason.slice(0, 250) + ' (retry ' + newRetryCount + '/' + maxRetries + ')'\n      } });\n    } else {\n      // Exhausted retries -- leave it as a terminal error for manual review\n      out.push({ json: {\n        'row_number': rowNumber,\n        '_sourceTab': sourceTab,\n        'Pin ID': rowPinId,\n        'Status': 'Error',\n        'Pin URL': '',\n        'Pinned Time': '',\n        'Metricool Post ID': '',\n        'Retry Count': newRetryCount,\n        'Scheduled Date': '',\n        'Error': reason.slice(0, 250) + ' (gave up after ' + maxRetries + ' retries)'\n      } });\n    }\n  }\n  // any other status (PENDING, PUBLISHING, AWAITING_CONFIRMATION, DRAFT) is still pending -- skip, checked again next run\n}\nreturn out;\n"
      },
