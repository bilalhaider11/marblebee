      "id": "f3d49d43-bbad-44be-9b49-327b53decb26",
      "name": "Get Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        11008,
        1584
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "HyOn8LPYniNVacXo",
          "name": "Metricool API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst sel = $('Select Scheduled').all().map(i => i.json);\nconst cfg = $('Set Config').first().json;\nconst maxRetries = cfg.maxRetries || 3;\nconst retryHours = (cfg.retryHours || '9,10').split(',').map(h => parseInt(h.trim(), 10)).filter(h => !isNaN(h)).sort((a, b) => a - b);\n\nfunction nextRetrySlot() {\n  const zone = 'America/Toronto';\n  const nowPlus15 = $now.plus({ minutes: 15 });\n  const nowLocal = $now.setZone(zone);\n  for (const h of retryHours) {\n    const slot = nowLocal.set({ hour: h, minute: 0, second: 0, millisecond: 0 });\n    if (slot > nowPlus15) return slot;\n  }\n  return nowLocal.plus({ days: 1 }).set({ hour: retryHours[0], minute: 0, second: 0, millisecond: 0 });\n}\n\n// Route by Platform sent 'tailwind' items down output 0 -> Merge Post Checks input 1 (Get Tailwind Post),\n// and everything else ('metricool') down output 1 -> Merge Post Checks input 0 (Get Post). Merge in\n// 'append' mode puts input-1 items first, then input-2 items -- so responses[] here is laid out as\n// [ all metricool responses in metricoolSel order ] followed by [ all tailwind responses in tailwindSel order ].\nconst metricoolSel = sel.filter(s => s.platform !== 'tailwind');\nconst tailwindSel = sel.filter(s => s.platform === 'tailwind');\nconst pairs = [\n  ...metricoolSel.map((s, i) => ({ sel: s, raw: responses[i] && responses[i].json, platform: 'metricool' })),\n  ...tailwindSel.map((s, i) => ({ sel: s, raw: responses[metricoolSel.length + i] && responses[metricoolSel.length + i].json, platform: 'tailwind' })),\n];\n\nfunction pickPost(r) { const o = Array.isArray(r) ? (r[0] || {}) : r; return (o && o.data) || o || {}; }\nfunction pickPinterestProvider(post) { const providers = post.providers || []; return providers.find(p => p.network === 'pinterest') || providers[0] || {}; }\nfunction pickTw(r) { const o = Array.isArray(r) ? (r[0] || {}) : r; return (o && o.data && (o.data.post || o.data)) || (o && o.post) || o || {}; }\nfunction pickHttpError(r) {\n  // Both Get Post and Get Tailwind Post have onError: continueRegularOutput, so a failed\n  // lookup (bad/pre-migration id, or a Metricool id that's actually a Tailwind id or vice\n  // versa) comes through as { error: {...} } instead of throwing -- without this check\n  // those rows would silently look \"still pending\" forever and retry the same failure\n  // every single hourly run.\n  const o = Array.isArray(r) ? (r[0] || {}) : r;\n  if (o && o.error) return 'Could not verify this post (invalid or wrong-platform post ID)';\n  return null;\n}\nfunction pinnedTimeIso(dateTime, zone) {\n  if (!dateTime) return '';\n  const dt = DateTime.fromISO(dateTime, { zone: zone || 'utc' });\n  return dt.isValid ? dt.toUTC().toFormat(\"yyyy-LL-dd'T'HH:mm:ss'Z'\") : '';\n}\nfunction pinnedTimeFromEpoch(ts) {\n  // Tailwind returns sentAt/sendAt as a Unix epoch number (seconds OR milliseconds --\n  // both are seen in practice), not an ISO string like Metricool's publicationDate.\n  if (ts == null || ts === '') return '';\n  let n = Number(ts);\n  if (isNaN(n)) return '';\n  if (n < 1e12) n *= 1000; // seconds -> ms\n  const dt = DateTime.fromMillis(n);\n  return dt.isValid ? dt.toUTC().toFormat(\"yyyy-LL-dd'T'HH:mm:ss'Z'\") : '';\n}\n\nconst out = [];\nfor (const { sel: s, raw, platform } of pairs) {\n  const httpError = pickHttpError(raw);\n  const rowPinId = s.rowPinId, rowNumber = s.row_number, sourceTab = s.sourceTab, retryCount = s.retryCount || 0, postId = s.postId;\n  if (!rowPinId) continue;\n\n  let status, publicUrl = '', pinnedTime = '', reason = '';\n  if (httpError) {\n    status = 'ERROR'; reason = httpError;\n  } else if (platform === 'metricool') {\n    const post = pickPost(raw);\n    const provider = pickPinterestProvider(post);\n    status = (provider.status || '').toString().toUpperCase();\n    publicUrl = provider.publicUrl || '';\n    pinnedTime = pinnedTimeIso((post.publicationDate || {}).dateTime, (post.publicationDate || {}).timezone);\n    reason = String(provider.detailedStatus || 'Metricool reported this post as failed');\n  } else {\n    // Tailwind: status is 'queued' | 'uploading' (still pending) | 'sent' (published, has pinId) |\n    // anything else is treated as failed -- better to surface + retry an unrecognized state than\n    // silently leave the row stuck on Scheduled forever.\n    const post = pickTw(raw);\n    const twStatus = String(post.status || '').toLowerCase();\n    if (twStatus === 'sent' && post.pinId) {\n      status = 'PUBLISHED';\n      publicUrl = 'https://www.pinterest.com/pin/' + post.pinId + '/';\n      pinnedTime = pinnedTimeFromEpoch(post.sentAt || post.sendAt);\n    } else if (twStatus === 'queued' || twStatus === 'uploading') {\n      status = 'PENDING';\n    } else {\n      status = 'ERROR';\n      reason = 'Tailwind reported this post as ' + (twStatus || '(unknown status)');\n    }\n  }\n\n  if (status === 'PUBLISHED' && publicUrl) {\n    out.push({ json: {\n      'row_number': rowNumber, '_sourceTab': sourceTab, 'Pin ID': rowPinId,\n      'Status': 'Published', 'Pin URL': publicUrl, 'Pinned Time': pinnedTime, 'Error': '',\n      'Metricool Post ID': platform === 'metricool' ? postId : '',\n      'Tailwind Post ID': platform === 'tailwind' ? postId : '',\n      'Platform': platform === 'metricool' ? 'Metricool' : 'Tailwind',\n      'Retry Count': retryCount, 'Scheduled Date': ''\n    } });\n  } else if (status === 'ERROR') {\n    const newRetryCount = retryCount + 1;\n    if (newRetryCount <= maxRetries) {\n      // Auto-retry: hand it back to WF2 as a fresh Review row (WF2 only ever creates via\n      // Metricool, so both post-ID columns and Platform are cleared regardless of which\n      // platform this attempt came from) with a new near-future Scheduled Date.\n      out.push({ json: {\n        'row_number': rowNumber, '_sourceTab': sourceTab, 'Pin ID': rowPinId,\n        'Status': 'Review', 'Pin URL': '', 'Pinned Time': '',\n        'Metricool Post ID': '', 'Tailwind Post ID': '', 'Platform': '',\n        'Retry Count': newRetryCount,\n        'Scheduled Date': nextRetrySlot().toFormat('yyyy-LL-dd HH:mm'),\n        'Error': reason.slice(0, 250) + ' (retry ' + newRetryCount + '/' + maxRetries + ')'\n      } });\n    } else {\n      out.push({ json: {\n        'row_number': rowNumber, '_sourceTab': sourceTab, 'Pin ID': rowPinId,\n        'Status': 'Error', 'Pin URL': '', 'Pinned Time': '',\n        'Metricool Post ID': '', 'Tailwind Post ID': '', 'Platform': '',\n        'Retry Count': newRetryCount, 'Scheduled Date': '',\n        'Error': reason.slice(0, 250) + ' (gave up after ' + maxRetries + ' retries)'\n      } });\n    }\n  }\n  // PENDING (still queued/uploading/awaiting confirmation/draft) -- skip, checked again next run\n}\nreturn out;"
      },
