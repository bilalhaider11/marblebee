      "id": "e137ab7e-f7a6-4427-943c-307d1c5cfcd0",
      "name": "Get Pins",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        11152,
        1168
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "rKfNzy77xzsMahH6",
          "name": "Template_control"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pins1 = $('Get Pins').all().map(i => ({ ...i.json, _sourceTab: $('Set Config').first().json.pinsTab }));\nconst pins2 = $('Get Pins 2').all().map(i => ({ ...i.json, _sourceTab: $('Set Config').first().json.pinsTab2 }));\nconst pins = [...pins1, ...pins2];\nfunction norm(s){ return (s==null?'':String(s)).trim().toLowerCase(); }\nconst out = [];\nfor (const p of pins) {\n  if (norm(p['Status']) !== 'scheduled') continue;\n  const metricoolId = (p['Metricool Post ID']==null?'':String(p['Metricool Post ID'])).trim();\n  const tailwindId = (p['Tailwind Post ID']==null?'':String(p['Tailwind Post ID'])).trim();\n  const platformCell = norm(p['Platform']);\n  // Prefer whichever platform the row itself claims; fall back to whichever ID is actually populated\n  // (covers legacy rows written before the Platform column existed).\n  let platform = null, postId = '';\n  if (platformCell === 'tailwind' && tailwindId) { platform = 'tailwind'; postId = tailwindId; }\n  else if (platformCell === 'metricool' && metricoolId) { platform = 'metricool'; postId = metricoolId; }\n  else if (metricoolId) { platform = 'metricool'; postId = metricoolId; }\n  else if (tailwindId) { platform = 'tailwind'; postId = tailwindId; }\n  if (!platform) continue;\n  out.push({ json: { rowPinId: p['Pin ID'], postId, platform, row_number: p['row_number'], sourceTab: p._sourceTab, retryCount: parseInt(p['Retry Count'], 10) || 0 } });\n}\nreturn out;"
      },
