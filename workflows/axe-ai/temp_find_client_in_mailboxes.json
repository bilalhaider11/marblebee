    {
      "id": "06aaedab-f7c3-436c-a715-0dc9b8888867",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3420,
        300
      ],
      "parameters": {
        "jsCode": "// Per mailbox: how many messages match, earliest and latest date, and the earliest messages. Headers only.\nconst spec = {\"gmail\": [{\"mailbox\": \"marblebee2025\", \"get\": \"Gmail get: marblebee2025\", \"list\": \"Gmail list: marblebee2025\"}, {\"mailbox\": \"marblebeeltd\", \"get\": \"Gmail get: marblebeeltd\", \"list\": \"Gmail list: marblebeeltd\"}, {\"mailbox\": \"marblebee1\", \"get\": \"Gmail get: marblebee1\", \"list\": \"Gmail list: marblebee1\"}], \"outlook\": [{\"mailbox\": \"Jack\", \"node\": \"Outlook search: Axe_AI-outlook\"}, {\"mailbox\": \"Mia\", \"node\": \"Outlook search: Mia_Outlook\"}, {\"mailbox\": \"Eve-cred(=Yolanda mailbox)\", \"node\": \"Outlook search: Eve_Outlook\"}, {\"mailbox\": \"Yolanda-cred(=Eve mailbox)\", \"node\": \"Outlook search: Yolanda_Outlook\"}]};\nconst cfg = $('Config').first().json;\nconst hdr = (m, name) => ((m.payload && m.payload.headers) || []).find(h => h.name.toLowerCase() === name.toLowerCase())?.value || '';\nconst rowsBy = {};\nconst errors = [];\nfor (const g of spec.gmail) {\n  let items = []; try { items = $(g.get).all().map(i => i.json); } catch (e) { errors.push(g.mailbox + ': did not run'); }\n  const rows = [];\n  for (const m of items) {\n    if (m.error) { errors.push(g.mailbox + ': ' + JSON.stringify(m.error).slice(0, 120)); continue; }\n    if (!m.id || !m.payload) continue;\n    const d = new Date(Number(m.internalDate)); if (isNaN(d.getTime())) continue;\n    rows.push({ mailbox: g.mailbox, date: d.toISOString().slice(0, 10), from: hdr(m, 'From').slice(0, 60), to: hdr(m, 'To').slice(0, 60), subject: hdr(m, 'Subject').slice(0, 80) });\n  }\n  rowsBy[g.mailbox] = rows;\n}\nfor (const o of spec.outlook) {\n  let items = []; try { items = $(o.node).all().map(i => i.json); } catch (e) { errors.push(o.mailbox + ': did not run'); }\n  const rows = [];\n  for (const r of items) {\n    if (r.error) { errors.push(o.mailbox + ': ' + JSON.stringify(r.error).slice(0, 120)); continue; }\n    for (const m of (r.value || [])) {\n      const d = new Date(m.receivedDateTime || m.sentDateTime); if (isNaN(d.getTime())) continue;\n      rows.push({ mailbox: o.mailbox, date: d.toISOString().slice(0, 10), from: ((m.from && m.from.emailAddress && (m.from.emailAddress.address || m.from.emailAddress.name)) || '').slice(0, 60), to: ((m.toRecipients || []).map(t => t.emailAddress && (t.emailAddress.address || t.emailAddress.name)).join(', ')).slice(0, 60), subject: String(m.subject || '').slice(0, 80) });\n    }\n  }\n  rowsBy[o.mailbox] = rows;\n}\nconst all = Object.values(rowsBy).flat().sort((a, b) => a.date < b.date ? -1 : 1);\nconst perMailbox = Object.entries(rowsBy).map(([k, rows]) => { const s = rows.map(r => r.date).sort(); return { mailbox: k, matches: rows.length, earliest: s[0] || null, latest: s[s.length - 1] || null, before_cutoff: rows.filter(r => r.date < cfg.cutoffDate).length }; });\nreturn [{ json: { searched: { gmail: cfg.gmailQuery, outlook: cfg.outlookSearch }, perMailbox, beforeCutoff: { cutoff: cfg.cutoffDate, count: all.filter(r => r.date < cfg.cutoffDate).length, messages: all.filter(r => r.date < cfg.cutoffDate).slice(0, 40) }, earliest25: all.slice(0, 25), errors: errors.slice(0, 10), note: 'Outlook search returns at most 100 matches per mailbox, Gmail at most 100. Headers only.' } }];"
      }
    }
