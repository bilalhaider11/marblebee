      "parameters": {
        "jsCode": "// One row per credential: the real mailbox address and whether the connection works.\nconst spec = [{\"kind\": \"Gmail\", \"group\": \"conversation extraction\", \"credential\": \"Sales-Assistant-Office\", \"node\": \"Gmail: Sales-Assistant-Office\"}, {\"kind\": \"Gmail\", \"group\": \"conversation extraction\", \"credential\": \"Axe-AI-Gmail (Terry)\", \"node\": \"Gmail: Axe-AI-Gmail (Terry)\"}, {\"kind\": \"Gmail\", \"group\": \"conversation extraction\", \"credential\": \"Sales-Assistant-Emily\", \"node\": \"Gmail: Sales-Assistant-Emily\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"support007\", \"node\": \"Gmail: support007\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"Support012\", \"node\": \"Gmail: Support012\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"terry_marblebee_cc\", \"node\": \"Gmail: terry_marblebee_cc\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"jackmamamarble\", \"node\": \"Gmail: jackmamamarble\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"LunaMamamarble\", \"node\": \"Gmail: LunaMamamarble\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"Jack_Newhomestone\", \"node\": \"Gmail: Jack_Newhomestone\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"Terry_Marblebee_Live\", \"node\": \"Gmail: Terry_Marblebee_Live\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"Terry_Marblebee_cfd\", \"node\": \"Gmail: Terry_Marblebee_cfd\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"terry_Marblebee_Site\", \"node\": \"Gmail: terry_Marblebee_Site\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"emily_Newhomestone\", \"node\": \"Gmail: emily_Newhomestone\"}, {\"kind\": \"Gmail\", \"group\": \"outreach / warmup\", \"credential\": \"Lunaruiz715\", \"node\": \"Gmail: Lunaruiz715\"}, {\"kind\": \"Gmail\", \"group\": \"alerts\", \"credential\": \"Gmail account 2 (error alerts)\", \"node\": \"Gmail: Gmail account 2 (error alerts)\"}, {\"kind\": \"Outlook\", \"group\": \"conversation extraction\", \"credential\": \"Axe_AI-outlook\", \"node\": \"Outlook: Axe_AI-outlook\"}, {\"kind\": \"Outlook\", \"group\": \"conversation extraction\", \"credential\": \"Mia_Outlook\", \"node\": \"Outlook: Mia_Outlook\"}, {\"kind\": \"Outlook\", \"group\": \"conversation extraction\", \"credential\": \"Eve_Outlook\", \"node\": \"Outlook: Eve_Outlook\"}, {\"kind\": \"Outlook\", \"group\": \"conversation extraction\", \"credential\": \"Yolanda_Outlook\", \"node\": \"Outlook: Yolanda_Outlook\"}];\nconst rows = spec.map(s => {\n  let j = {};\n  try { j = $(s.node).first().json || {}; } catch (e) { j = { error: 'node did not run' }; }\n  const err = j.error ? (typeof j.error === 'string' ? j.error : (j.error.message || JSON.stringify(j.error))) : '';\n  // Outlook: the check reads the newest sent item (needs mail permission, like the real workflows): sender address + date.\n  if (s.kind === 'Outlook' && !err && Array.isArray(j.value)) { const m = j.value[0]; let addr = (m && m.from && m.from.emailAddress && m.from.emailAddress.address) || '';\n    if (!/@/.test(addr)) { // internal Exchange id: read the real address from the From header\n      const h = (m && m.internetMessageHeaders || []).find(x => String(x.name).toLowerCase() === 'from');\n      const mm = h && /[\\w.+-]+@[\\w-]+\\.[\\w.-]+/.exec(String(h.value));\n      addr = mm ? mm[0] : (m && m.from && m.from.emailAddress && m.from.emailAddress.name) || addr;\n    }\n    j = m ? { mail: addr || '(sent items empty)', lastSent: m.sentDateTime } : { mail: '(no sent items)' }; }\n  const ok = !err && (j.emailAddress || j.mail || j.userPrincipalName);\n  return { group: s.group, type: s.kind, credential: s.credential, connected: !!ok,\n    mailbox: j.emailAddress || j.mail || j.userPrincipalName || '',\n    messagesTotal: j.messagesTotal, threadsTotal: j.threadsTotal, lastSent: j.lastSent,\n    problem: ok ? '' : (err || j.message || 'no answer').toString().slice(0, 160) };\n});\nconst conv = rows.filter(r => r.group === 'conversation extraction');\nreturn [{ json: {\n  conversationExtraction: conv.map(r => ({ type: r.type, credential: r.credential, mailbox: r.mailbox || '(not connected)', connected: r.connected, messages: r.messagesTotal, threads: r.threadsTotal, lastSent: r.lastSent, problem: r.problem })),\n  notConnected: rows.filter(r => !r.connected).map(r => ({ type: r.type, credential: r.credential, group: r.group, problem: r.problem })),\n  otherMailboxesInN8n: rows.filter(r => r.group !== 'conversation extraction').map(r => ({ credential: r.credential, group: r.group, mailbox: r.mailbox || '(not connected)', connected: r.connected })),\n  note: 'Only the mailboxes in conversationExtraction feed the client conversation data. Any address the team uses with clients that is NOT listed there is a source of missing conversations.' } }];"
      }
    }
  ],
