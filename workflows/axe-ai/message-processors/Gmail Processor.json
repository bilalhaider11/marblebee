{
  "name": "AXE AI | Gmail Processor",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// One run per email: 'Merge | Attachment Branches' hands over the links of ALL its attachments\n// (uploaded now + already in Drive). Before, each branch ran this node separately, so an email with\n// both new and already-uploaded attachments was logged twice, each row with only part of the links.\n// Drop tabName, it is routing metadata (which tab to write to), not a column of the sheet.\nconst { tabName, ...previousData } = $('If Has Attachments').item.json;\nconst sheet_id = $('Loop | Gmail Message IDs').item.json.sheet_id;\n\n// Upload results carry id (+ webViewLink); already-uploaded ones carry webViewLink only\nconst links = $input.all()\n  .map(item => item.json.webViewLink\n    || (item.json.id ? `https://drive.google.com/file/d/${item.json.id}/view?usp=drivesdk` : null))\n  .filter(link => !!link);\n\n// Gmail rows keep their own link columns: attachment1 / attachment2 / ... (the Outlook processor\n// writes webViewLink1 / webViewLink2 / ...). A column that does not exist yet is created by the append.\nconst linkFields = {};\nlinks.forEach((link, index) => {\n  linkFields[`attachment${index + 1}`] = link;\n});\n\nreturn [\n  {\n    json: {\n      ...previousData,\n      ...linkFields,\n      hasAttachments: links.length > 0,\n      sheet_id: sheet_id\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9888,
        1904
      ],
      "id": "d04adf0b-1d4b-4c46-b4a5-361139ea33ca",
      "name": "Merge | Add Drive Links"
    },
    {
      "parameters": {
        "inputDataFieldName": "={{ $json.binary_field_name }}",
