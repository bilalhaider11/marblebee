    {
      "parameters": {
        "jsCode": "// One request per attachment goes into the exact-name lookup above, so 'results' has exactly one item\n// per attachment, in the same order, each {files: [...]} with the files of this attachments folder\n// whose name is EXACTLY the attachment's file name (oldest first). The old lookup was a fuzzy\n// Drive 'name contains' search capped at 5 results, which missed file names such as\n// Bathtub_26DDYP43_1.jpg -- so the same photo was uploaded again on every run.\n// A file counts as already uploaded when name AND byte size match (size unknown -> name only).\n// Preserve the ORIGINAL item's json (file_name, binary_field_name, ...) and binary data untouched,\n// just annotated with the match result -- 'Drive | Upload Attachment' needs them to upload.\nconst originals = $('Expand | Split Attachments').all();\nconst results = $input.all();\n\nreturn originals.map((orig, idx) => {\n  const expected = (orig.json.file_name || '').toString().trim().toLowerCase();\n  const size = orig.json.file_size;\n  const files = results[idx]?.json?.files || [];\n  const exact = files.find(f =>\n    (f.name || '').toString().trim().toLowerCase() === expected &&\n    (size === null || size === undefined || f.size === undefined || String(f.size) === String(size)));\n  return {\n    json: {\n      ...orig.json,\n      _existingFileId: exact ? exact.id : '',\n      _existingFileWebViewLink: exact ? (exact.webViewLink || '') : ''\n    },\n    binary: orig.binary,\n    pairedItem: idx\n  };\n});\n"
      },
