    {
      "parameters": {
        "jsCode": "// Each conversation sheet is created via the Sheets API with an\n// explicit sheets[] array and no sheetId specified -- per Google's own\n// docs, an unspecified sheetId is RANDOMLY GENERATED, not 0. So neither\n// a hardcoded name ('sheet1'/'Sheet1', which genuinely varies per\n// client) nor a hardcoded gid ('gid=0', confirmed NOT reliable here)\n// can address it. The only robust option: look up this specific\n// document's actual (single) tab name at runtime and reference it by\n// name from here on, since every conversation sheet has exactly one tab.\nconst original = $('Normalize | Extract Clean Reply Text2').item;\nconst tabName = $json.sheets?.[0]?.properties?.title;\nif (!tabName) {\n  throw new Error(`Could not resolve the conversation sheet's tab name for sheet_id ${original.json.sheet_id}`);\n}\nreturn [{\n  json: { ...original.json, tabName },\n  binary: original.binary\n}];"
      },
