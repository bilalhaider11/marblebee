    {
      "parameters": {
        "jsCode": "// Map to the shape 'Merge | Add Drive Links' expects (a bare webViewLink)\n// -- the item still carries the original file_name/binary fields from\n// 'Pick Exact Attachment Match', which aren't needed on this skip-upload\n// path and are intentionally dropped here. Falls back to the canonical Drive\n// URL built from the file id when the lookup returned no webViewLink.\nreturn $input.all().map(item => ({\n  json: {\n    webViewLink: item.json._existingFileWebViewLink\n      || (item.json._existingFileId ? `https://drive.google.com/file/d/${item.json._existingFileId}/view?usp=drivesdk` : null)\n  },\n  pairedItem: item.pairedItem\n}));\n"
      },
