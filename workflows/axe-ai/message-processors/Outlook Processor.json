    {
      "parameters": {
        "jsCode": "// Each conversation sheet is created via the Sheets API with an explicit\n// sheets[] array and no sheetId specified -- per Google's own docs, an\n// unspecified sheetId is RANDOMLY GENERATED, not 0, and the tab name itself\n// is also inconsistent across sheets ('sheet1' vs 'Sheet1'). Neither a\n// hardcoded name nor a hardcoded gid can address it. Look up this specific\n// document's actual (single) tab name at runtime and reference it by name\n// from here on -- same fix as the Gmail processor.\nconst original = $('Normalize | Extract Message Metadata').item;\nconst tabName = $json.sheets?.[0]?.properties?.title;\nif (!tabName) {\n  throw new Error(`Could not resolve the conversation sheet's tab name for sheet_id ${original.json.sheet_id}`);\n}\nreturn [{\n  json: { ...original.json, tabName },\n  binary: original.binary\n}];"
      },
