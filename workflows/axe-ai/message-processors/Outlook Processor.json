    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst data = $('Load Queued Messages from Queue Sheet');\nconst sheet_id = data.item.json.sheet_id ?? '';\n// Referenced directly from the queue read (not the splitInBatches loop node)\n// and coerced to '' instead of left undefined -- when this evaluated to\n// undefined, the resulting json object never had a row_number KEY at all\n// (JS/JSON serialization drops undefined-valued keys entirely), and since\n// the sheet's header already reserves a column for it, autoMapInputData\n// wrote fromEmail's value into the row_number cell instead and shifted\n// every field after it one column left. Same fix as the Gmail processor.\nconst row_number = data.item.json.row_number ?? '';\n// logged-in mailbox email\n// the mailbox this message was fetched from (queue column by_mail), so SENT / RECEIVED is\n// judged against that mailbox's own address; unknown / older rows ('outlook') = the original mailbox\nconst MAILBOX_ADDRESS = {\n  outlook: 'jack@marblebee.com',\n  outlook_jack: 'jack@marblebee.com',\n  outlook_mia: 'mia@marblebee.com',\n  outlook_eve: 'eve@marblebee.com',\n  outlook_yolanda: 'yolanda@marblebee.com'\n};\nconst byMail = String(data.item.json.by_mail || 'outlook').trim().toLowerCase();\nconst MY_EMAIL = (MAILBOX_ADDRESS[byMail] || MAILBOX_ADDRESS.outlook).toLowerCase();\n\n/**\n * Cut message at polite sign-offs like \"Kind regards,\"\n */\nfunction cutAtKindRegards(text = '') {\n  const match = text.match(\n    /\\b(Kind regards|Best regards|Regards|Warm regards),\\b/i\n  );\n  return match ? text.slice(0, match.index).trim() : text.trim();\n}\n\n/**\n * Extract latest message from Outlook/Gmail HTML body\n */\nfunction extractLatestMessageFromHtml(html = '') {\n  if (!html) return '';\n\n  // Remove scripts & styles\n  html = html\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '');\n\n  // Cut at known reply/forward separators (earliest match wins)\n  const cutPatterns = [\n    /<hr[\\s\\S]*?>/i,\n    /<div[^>]+id=[\"']divRplyFwdMsg[\"'][\\s\\S]*?>/i,\n    /<div[^>]+class=[\"'][^\"']*gmail_quote[^\"']*[\"'][\\s\\S]*?>/i,\n    /\\nOn\\s+(Mon|Tue|Wed|Thu|Fri|Sat|Sun),\\s+[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4},/i\n  ];\n\n  for (const pattern of cutPatterns) {\n    const match = html.match(pattern);\n    if (match) {\n      html = html.slice(0, match.index);\n    }\n  }\n\n  // Strip remaining HTML -> plain text\n  return html\n    .replace(/<\\/?[^>]+>/g, '')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n\nfunction cutAtReplyDate(text = '') {\n  const replyRegex =\n    /\\nOn\\s+(Mon|Tue|Wed|Thu|Fri|Sat|Sun),\\s+[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4},\\s+\\d{1,2}:\\d{2}\\s*(AM|PM)/i;\n\n  const match = text.match(replyRegex);\n  return match ? text.slice(0, match.index).trim() : text.trim();\n}\n\n/**\n * Strip HTML safely\n */\nfunction stripHtml(html = '') {\n  return html\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<\\/?[^>]+(>|$)/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n/**\n * Cut text at first occurrence of:\n *  - 5 or more underscores\n *  - \"Get Outlook for \"\n * whichever comes first\n */\nfunction cutAtSeparator(text = '') {\n  const match = text.match(/_{5,}|Get Outlook for /i);\n  return match ? text.slice(0, match.index).trim() : text.trim();\n}\n\nreturn items.map((item, index) => {\n  const msg = item.json;\n\n  // sender\n  const fromEmail =\n    msg.from?.emailAddress?.address || null;\n  const fromName =\n    msg.from?.emailAddress?.name || null;\n\n  // receivers -- joined into a plain comma-separated string, matching the\n  // Gmail processor's convention for this shared sheet (this used to be a\n  // raw array, which stringified into the cell as e.g. [\"a@b.com\"] instead\n  // of a clean address).\n  const toRecipientsArr = msg.toRecipients || [];\n  const toEmail =\n    toRecipientsArr.map(r => r.emailAddress?.address).filter(Boolean).join(', ') || null;\n  const toName =\n    toRecipientsArr.map(r => r.emailAddress?.name).filter(Boolean).join(', ') || null;\n\n  // sent or received -- uppercase to match the Gmail processor's convention;\n  // a client's conversation sheet interleaves both providers, so the two\n  // must agree on casing.\n  // SENT = written by our side: the mailbox owner, OR any other Marblebee address (a colleague\n  // writing to the client with this mailbox in copy, or a shared company Gmail account).\n  const ownSender = fromEmail?.toLowerCase() === MY_EMAIL || /marblebee/i.test(fromEmail || '');\n  const direction = ownSender ? 'SENT' : 'RECEIVED';\n\n  // body (HTML -> text)\nlet message = '';\n\nif (msg.body?.contentType === 'html') {\n  message = extractLatestMessageFromHtml(msg.body.content);\n} else {\n  message = stripHtml(msg.body?.content || '');\n}\n\n// Remove signatures / Outlook footer\nmessage = cutAtSeparator(message);\n\n// Remove quoted reply thread\nmessage = cutAtReplyDate(message);\n\n// Remove content after \"Kind regards,\"\nmessage = cutAtKindRegards(message);\n\n\n  return {\n    json: {\n      id: msg.id ?? '',\n      sheet_id,\n      row_number,\n      message,\n      fromEmail,\n      fromName,\n      toEmail,\n      toName,\n      direction,\n      timestamp:\n        msg.sentDateTime || msg.receivedDateTime,\n      subject: msg.subject || null,\n      hasAttachments: msg.hasAttachments || false\n    },\n\n    binary: $input.all()[index]?.binary || {}\n  };\n});"
      },
