    {
      "parameters": {
        "jsCode": "// One item per attachment. file_size = the real byte size of the attachment: together with the file\n// name it identifies a file, so a generic name such as 'image.png' (different pictures in different\n// emails) is not mistaken for a file that is already in Drive, while the same file attached again\n// is recognised and reused instead of being uploaded once more.\nconst items = $input.all();\nconst newItems = [];\n\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex++) {\n  const item = items[itemIndex];\n  const jsonData = item.json || {};\n  const binaries = item.binary || {};\n\n  let index = 0;\n  for (const key in binaries) {\n    // Get the original filename if available\n    const originalFileName = binaries[key].fileName || key;\n    const binaryKey = `attachment_${index}`;\n\n    let fileSize = null;\n    try {\n      fileSize = (await this.helpers.getBinaryDataBuffer(itemIndex, key)).length;\n    } catch (e) {\n      fileSize = null; // unknown size: the lookup then falls back to the file name alone\n    }\n\n    newItems.push({\n      json: {\n        ...jsonData,\n        file_name: originalFileName,\n        binary_field_name: binaryKey, // <-- added field name of binary\n        file_size: fileSize\n      },\n      binary: {\n        [binaryKey]: binaries[key]\n      },\n      // keeps the lineage back to the source email for every downstream $('Node').item lookup\n      pairedItem: itemIndex\n    });\n    index++;\n  }\n}\n\nreturn newItems;\n"
      },
