    {
      "parameters": {
        "jsCode": "// 'Pick Exact Attachment Match' only sets _existingFileWebViewLink from\n// the Drive search result's own webViewLink -- that search response isn't\n// guaranteed to include it either, so fall back to the same canonical\n// Drive URL format built from the file id it always does return.\nreturn $input.all().map(item => ({\n  json: {\n    webViewLink: item.json._existingFileWebViewLink\n      || (item.json._existingFileId ? `https://drive.google.com/file/d/${item.json._existingFileId}/view?usp=drivesdk` : null)\n  },\n  pairedItem: item.pairedItem\n}));\n"
      },
